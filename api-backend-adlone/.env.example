# Server Configuration
PORT=4000
NODE_ENV=development

# Network Configuration
HOST=0.0.0.0

# SQL Server Configuration (REQUIRED)
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=ADL_ONE_DB
DB_USER=sa
DB_PASSWORD=your_password_here
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Base de datos histórica
DB_HISTORICO_DATABASE=LaboratorioADLHistorico

# JWT (REQUIRED — no fallback, server will not start without this)
JWT_SECRET=generate_a_random_secret_here

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@domain.com
SMTP_PASS=your_smtp_password

# File Paths
UPLOAD_PATH=./uploads
RUTA_FOTOS=C:\path\to\fotos
# PROFILE_PICS_PATH=C:\path\to\profile_pics

# --- Llamadas servidor-a-servidor a api-app-mam (regenerar FoMa/Cadena) ---
APP_MAM_API_URL=http://localhost:8001
# Debe coincidir con INTERNAL_API_KEY en api-app-mam/.env
INTERNAL_API_KEY=

# --- Conexión con el portal de clientes (WebClientesV2) ---
# URL del backend del portal. En el servidor de producción corre en la misma máquina: http://localhost:8025
WEBCLIENTES_API_URL=http://localhost:8020
# Llave de la cuenta de servicio «ADL ONE» en ADL WEB GO. Scopes: ingesta:write, cotizaciones:write, cotizaciones:read y equipo:read (empresas visibles del equipo GEM).
WEBCLIENTES_API_KEY=

# Clave con la que WebClientesV2 (el portal) le pide a este backend emitir avisos en vivo. Debe ser el MISMO valor que
# ADL_ONE_INBOUND_KEY en el .env del portal (un texto aleatorio largo).
WEBCLIENTES_INBOUND_KEY=

# Carpeta donde se guardan los PDF de Facturación Salud (se crean sola las subcarpetas <año>/<MES>). Si se deja vacía, el PDF solo se descarga.
FACTURACION_SALUD_DOCS_DIR=

# Base local de pruebas de Facturación Salud (solo localhost; con DB_SALUD_INSTANCE no se usa el puerto)
DB_SALUD_SERVER=localhost
DB_SALUD_INSTANCE=
DB_SALUD_DATABASE=LaboratorioADL
DB_SALUD_USER=sa
DB_SALUD_PASSWORD=

# Modo pruebas de correo: mientras no estemos en producción, TODO correo llega solo a esta dirección (si queda vacía, a vremolcoy@adldiagnostic.cl).
EMAIL_REDIRECT_TO=
# El día de salir a producción: EMAIL_PRODUCCION=1 apaga la redirección (y hay que revisar EMAIL_ALLOWED_DOMAINS). Dejar la variable de arriba vacía NO la apaga.
# EMAIL_PRODUCCION=1

# Solo correos de ADL (opcional): dominios permitidos separados por coma. Por defecto solo adldiagnostic.cl; «*» desactiva el filtro.
EMAIL_ALLOWED_DOMAINS=adldiagnostic.cl

# Vigilante (src/vigilante): correo si la pantalla web o el servidor de ADL ONE dejan de responder. Es un proceso aparte (pm2: adl-one-vigilante).
# Obligatoria para que mande correos: direcciones de ADL separadas por coma. Vacía = solo escribe en el log.
VIGILANTE_DESTINATARIOS=
# Opcionales (valores por defecto entre paréntesis):
# VIGILANTE_INTERVALO_S=60            (cada cuántos segundos comprueba)
# VIGILANTE_UMBRAL=3                  (fallos seguidos antes de avisar; con 60 s son ~3 minutos)
# VIGILANTE_RECORDATORIO_MIN=120      (cada cuántos minutos recuerda mientras siga caído)
# VIGILANTE_TIMEOUT_S=10              (segundos de espera de cada comprobación)
# VIGILANTE_URL_FRONTEND=http://127.0.0.1:5174/
# VIGILANTE_URL_BACKEND=http://127.0.0.1:8002/
# VIGILANTE_URL_SAMPLING=http://127.0.0.1:8001/health
# VIGILANTE_SIMULAR=1                 (no envía nada; escribe en el log lo que enviaría)
