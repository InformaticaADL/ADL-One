# Server Configuration
PORT=4000
NODE_ENV=development

# Network Configuration
HOST=0.0.0.0

# SQL Server Configuration (REQUIRED)
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=ADL_ONE_DB
DB_USER=sa
DB_PASSWORD=your_password_here
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# JWT (REQUIRED — no fallback, server will not start without this)
JWT_SECRET=generate_a_random_secret_here

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@domain.com
SMTP_PASS=your_smtp_password

# File Paths
UPLOAD_PATH=./uploads
RUTA_FOTOS=C:\path\to\fotos
# PROFILE_PICS_PATH=C:\path\to\profile_pics

# --- Llamadas servidor-a-servidor a api-app-mam (regenerar FoMa/Cadena) ---
APP_MAM_API_URL=http://localhost:8001
# Debe coincidir con INTERNAL_API_KEY en api-app-mam/.env
INTERNAL_API_KEY=

# --- Conexión con el portal de clientes (WebClientesV2) ---
# URL del backend del portal. En el servidor de producción corre en la misma máquina: http://localhost:8025
WEBCLIENTES_API_URL=http://localhost:8020
# Llave para facturación y cotizaciones (scopes ingesta:write, cotizaciones:write, cotizaciones:read).
WEBCLIENTES_API_KEY=
# Llave solo para las solicitudes de clientes (scope solicitudes:write). Si se deja vacía se usa WEBCLIENTES_API_KEY.
WEBCLIENTES_SOLICITUDES_KEY=
